# Backend runtime configuration
# Copy these values into your shell environment or a local .env loader.
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins that may call the API from a browser.
CORS_ORIGINS=https://your-domain.example
# Required for all protected API routes, including local/paper requests.
# Set the same value as VITE_API_TOKEN in client/.env.
API_TOKEN=
# Safe default. Use 'live' only after the demo-account rollout checklist passes.
TRADING_MODE=paper

# Required for the AI execution loop. Keep the real key only in server/.env (never commit).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=30
AI_MIN_CONFIDENCE=0.70
# Required for unattended startup. Alternatively enter credentials through Settings after startup.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Live mode requires these independently configured identity pins. The
# connected account must match login, server, and trade mode exactly.
MT5_EXPECTED_LOGIN=
MT5_EXPECTED_SERVER=
MT5_EXPECTED_TRADE_MODE=demo
MT5_EXPECTED_MARGIN_MODE=hedging
# Optional: full path to terminal64.exe for auto-launch (Windows)
MT5_TERMINAL_PATH=
# Linux only: opt in after configuring and starting the mt5linux bridge.
MT5LINUX_ENABLED=0


NEWS_API_KEY=
# Optional NewsAPI.org (or compatible) key; Yahoo RSS remains keyless fallback.
NEWS_API_URL=https://newsapi.org/v2/everything
YAHOO_FINANCE_RSS_URL=https://feeds.finance.yahoo.com/rss/2.0/headline?s=EURUSD%3DX%2CGBPUSD%3DX%2CGC%3DF&region=US&lang=en-US
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
# Readiness fails when the newest closed H1 candle is older than this value.
MAX_CANDLE_AGE_SECONDS=7200

# Risk limits; confirm units against the target broker and owner-approved profile.
RISK_PER_TRADE_PCT=1.5
MAX_DAILY_LOSS_PCT=4.0
MAX_WEEKLY_LOSS_PCT=6.0
MAX_DRAWDOWN_FROM_PEAK_PCT=8.0
MAX_AGGREGATE_RISK_PCT=3.0
MAX_SPREAD_POINTS=50
MAX_STOP_ATR_MULTIPLIER=3.0
MIN_REWARD_RISK_RATIO=1.0
MAX_REWARD_RISK_RATIO=5.0
MAX_TRADES_PER_DAY=6
MAX_CONCURRENT_POSITIONS=3
# Persistent local guard/control state. Back up securely and never clear after a halt
# until broker positions and history have been reconciled.
RISK_STATE_FILE=risk_guard_state.json
CONTROL_STATE_FILE=control_state.json
KILL_SWITCH_FILE=emergency.kill
REQUIRE_SENTIMENT_FEED=false
REQUIRE_NEWS_FEED=true
