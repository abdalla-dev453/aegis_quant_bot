# Backend runtime configuration
# Copy these values into your shell environment or a local .env loader.
API_HOST=127.0.0.1
API_PORT=8000
# Set this in production. Local loopback requests work without it.
API_TOKEN=

# MetaTrader 5 credentials: never commit real values.
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

NEWS_API_KEY=
NEWS_API_BASE_URL=https://api.example-economic-calendar.com/v1
LOG_LEVEL=INFO
